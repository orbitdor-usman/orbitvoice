# Server-only key. Never prefix this with NEXT_PUBLIC_ and never expose it in client code.
DOWNLOAD_ANALYTICS_API_KEY=replace-with-a-long-random-secret
# Optional absolute path for a persistent stats file on a self-hosted Node server.
# DOWNLOAD_STATS_FILE=C:\\data\\orbitvoice-downloads.json
# On Vercel, use a durable public URL (GitHub Release, object storage, or CDN) for the 129 MB installer.
ORBITVOICE_INSTALLER_URL=https://github.com/orbitdor-usman/orbitvoice/releases/download/v1.1.0/Orbitvoice-1.1.0-Setup.exe
